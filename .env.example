# seaLens Environment Configuration
# Copy this file to .env and fill in values. Never commit real credentials.

# Copernicus Marine Service
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# ECMWF / CDS API (if used)
CDSAPI_URL=
CDSAPI_KEY=

# NOAA / Data access
NOAA_AIS_TOKEN=

# API configuration
SEALENS_API_HOST=0.0.0.0
SEALENS_API_PORT=8000

# Optional: model paths
UNET_CHECKPOINT_PATH=ml_engine/checkpoints/sar_unet_oil_spill.pt
