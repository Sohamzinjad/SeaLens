# seaLens Environment Configuration
# Copy this file to .env and fill in values. NEVER commit real credentials.

# Copernicus Marine Service
COPERNICUSMARINE_SERVICE_USERNAME=your_username_here
COPERNICUSMARINE_SERVICE_PASSWORD=your_password_here

# ECMWF CDS API
CDSAPI_URL=https://cds.climate.copernicus.eu/api/v2
CDSAPI_KEY=your_cds_api_key_here

# NOAA Data Access
NOAA_AIS_TOKEN=your_noaa_token_here

# GitHub (if needed)
GITHUB_TOKEN=your_github_token_here

# API Configuration
SEALENS_API_HOST=0.0.0.0
SEALENS_API_PORT=8000
SEALENS_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Security
API_RATE_LIMIT=100
MAX_DOWNLOAD_MB=500
ENABLE_AUTH=false

# Model Paths
UNET_CHECKPOINT_PATH=ml_engine/checkpoints/sar_unet_oil_spill.pt
