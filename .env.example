# seaLens Environment Configuration
# Copy this file to .env and fill in values. NEVER commit real credentials.

# Copernicus Marine Service
COPERNICUSMARINE_SERVICE_USERNAME=your_username_here
COPERNICUSMARINE_SERVICE_PASSWORD=your_password_here

# Browser origin allowed by the local FastAPI server
SEALENS_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Optional API protection for a shared deployment. Leave unset for local demos.
# SEALENS_API_KEY=generate-a-long-random-value
SEALENS_RATE_LIMIT_PER_MINUTE=120

# Optional PostGIS connection. The current demo remains file-backed until a
# PostgreSQL driver and migration workflow are enabled in deployment.
# DATABASE_URL=postgresql://sealens:change-this@localhost:5432/sealens
